{
    "name": "aoe2companion",
    "main": "expo-router/entry",
    "version": "1.0.0",
    "scripts": {
        "start": "NODE_OPTIONS=--max-old-space-size=8192 bash start.sh",
        "start:web": "NODE_OPTIONS=--max-old-space-size=8192 bash start.sh web",
        "explorer:variants": "node scripts/serve-aoe4-explorer-variants.mjs",
        "start:ios": "bash run.sh ios",
        "start:android": "bash run.sh android",
        "start:tunnel": "NODE_OPTIONS=--max-old-space-size=8192 expo start -c --dev-client -p 8081 --tunnel",
        "start:perf": "NODE_OPTIONS=--max-old-space-size=8192 bash start.sh perf",
        "prebuild": "bash prebuild.sh",
        "dev:ios": "PLATFORM=ios bash publish-dev.sh",
        "dev:sim:ios": "PLATFORM=ios bash publish-dev-sim.sh",
        "dev:android": "PLATFORM=android bash publish-dev.sh",
        "dev:android:install": "PLATFORM=android bash publish-dev-install.sh",
        "internal:android": "PLATFORM=android bash publish-internal.sh",
        "internal:android:install": "PLATFORM=android bash publish-internal-install.sh",
        "publish:ios": "PLATFORM=ios bash publish-with-sentry.sh",
        "publish:android": "PLATFORM=android bash publish-with-sentry.sh",
        "publish:all": "yarn publish:ios && yarn publish:android",
        "store:ios": "bun scripts/store-release.ts ios",
        "store:android": "bun scripts/store-release.ts android",
        "store:all": "bun scripts/store-release.ts all",
        "android": "expo run:android",
        "ios": "expo run:ios",
        "deploy": "bash deploy.sh",
        "upload:translations": "bash upload-translations.sh",
        "app-update-types": "expo-type-information module-interface -m modules/app-update",
        "log": "bash log.sh",
        "lint": "biome lint src",
        "lint:hooks": "eslint src",
        "lint:compiler": "node scripts/react-compiler-report.js"
    },
