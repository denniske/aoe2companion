    "tips.item.note.automaticfarmseeding": "स्वचालित रूप से नए खेतों को बीज करने के लिए ऑटो बीज का उपयोग करें",
    "tips.item.note.rotategates": "गेट्स को घुमाने के लिए कंट्रोल + स्क्रॉल का उपयोग करें",
    "tips.item.note.taskqueue": "कार्यों को कतारबद्ध करने के लिए Shift + राइट क्लिक का उपयोग करें",
    "tips.item.note.farmingefficiently": "मिल और शहर के केंद्र के आसपास सर्कल में खेतों का निर्माण।",
    "tips.item.note.smalltrees": "एक छोटे संस्करण के साथ पेड़ों की जगह। बेहतर अवलोकन देता है और छिद्रों का पता लगाना आसान बनाता है।",
    "tips.item.note.zetnusimprovedgridmod": "इलाके पर एक ग्रिड दिखाता है। इमारतों को रखना और दूरियों को मापना आसान बनाता है। एकीकृत ग्रिड से अधिक सूक्ष्म।",
    "tips.item.note.idlevillagerpointer": "सभी निष्क्रिय ग्रामीणों पर एक विस्मयादिबोधक बिंदु जोड़ता है जिससे आपको उनकी पहचान करना आसान हो जाता है।",
    "tips.item.note.idlevillagerhighlightbyarrow": "नीचे एक लाल तीर जोड़कर निष्क्रिय ग्रामीण बटन पर प्रकाश डाला गया।",
    "tips.item.note.nointro": "हर बार इंट्रो वीडियो को प्रभावी रूप से छोड़ने के लिए 0.2s लंबे खाली वीडियो के साथ इंट्रो वीडियो को बदल देता है।",
    "tips.item.note.hugenumber": "एक इष्टतम दृश्यता के लिए 50% तक समूह संख्या को नियंत्रित करता है।",
    "tips.item.note.blacksmithupgrades": "आर्चर हमेशा हमले के उन्नयन को पहले खरीदते हैं। इन्फैंट्री और कैवर्ली के लिए हमेशा रक्षा उन्नयन पहले खरीदें।",
    "tips.item.note.selectingallidlevillagers": "Shift + का उपयोग करें। सभी निष्क्रिय ग्रामीणों का चयन करने के लिए।",
    "tips.item.note.selectingalllandmilitaryunits": "सभी भूमि सैन्य इकाइयों का चयन करने के लिए Shift + का उपयोग करें।",
    "tips.item.note.donotstockpileresources": "हमेशा अपने पास मौजूद संसाधनों को खर्च करने की कोशिश करें, जिससे अगली उम्र तक आगे बढ़ने के लिए संसाधनों की बचत हो।",
    "tips.nopreview": "कोई पूर्वावलोकन नहीं",
